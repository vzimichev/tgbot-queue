TELEGRAM_TOKEN=123456:replace-me
SSH_HOST=root@your-server
SSH_REDIS_PORT=6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=replace-me
# Keep Redis configured for Celery results. Set CELERY_BROKER=sqs to use SQS
# for messages, then provide the existing queue below.
CELERY_BROKER=redis
# SQS_REGION=eu-central-1
# SQS_QUEUE_NAME=telegram_updates
# SQS_QUEUE_URL=https://sqs.eu-central-1.amazonaws.com/123456789012/telegram_updates
# SQS_POLLING_INTERVAL=1
# SQS_VISIBILITY_TIMEOUT=3600
TELEGRAM_REQUEST_TIMEOUT=600
FACESWAP_CLIENT_DIR=/path/to/faceswap-client
FACESWAP_API_HOST=127.0.0.1
FACESWAP_API_PORT=8001
FACESWAP_API_BASE_URL=http://127.0.0.1:8001
