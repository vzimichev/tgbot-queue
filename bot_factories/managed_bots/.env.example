# Shared by the admin and managed workers.
SQS_REGION=eu-central-1
TELEGRAM_REQUEST_TIMEOUT=600
ADMIN_BOT_TOKEN=123456:replace-me
ADMIN_BOT_OWNER_ID=123456789
# Must match WEBHOOK_SECRET_TOKEN in the gateway configuration.
WEBHOOK_SECRET_TOKEN=replace-with-the-gateway-secret
ADMIN_BOT_CHILD_WEBHOOK_URL=https://your-domain.example/webhook/managed

# Compose maps each worker's queue to SQS_QUEUE_URL.
ADMIN_BOT_SQS_QUEUE_URL=https://sqs.eu-central-1.amazonaws.com/123456789012/telegram_updates
# Queue created by deploy/aws/5-managed-sqs-stack.yaml.
MANAGED_BOT_SQS_QUEUE_URL=https://sqs.eu-central-1.amazonaws.com/123456789012/tgbot-queue-managed-telegram-updates
