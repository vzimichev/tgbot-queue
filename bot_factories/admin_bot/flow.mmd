flowchart LR
    OWNER["Owner"]
    RECIPIENT["Recipient"]

    subgraph TELEGRAM["Telegram"]
        TG_BOT["Admin bot chat"]
        TG_UI["Recipient picker and bot creation UI"]
        TG_EVENTS["message / users_shared / managed_bot / callback_query updates"]
        TG_API["Bot API: tokens and access settings"]
        CHILD["Created bot"]
    end

    subgraph GATEWAY["Cloud API Gateway"]
        WEBHOOK["POST /webhook"]
        VALIDATE["Validate webhook secret"]
        PUBLISH["Publish telegram.process_update"]
    end

    subgraph REDIS["Redis"]
        QUEUE["telegram_updates queue"]
    end

    subgraph WORKER["Admin Worker"]
        CELERY["Celery task"]
        ROUTER["aiogram admin_router"]
        DIALOG["Recipient and limit dialogue"]
        FSM["aiogram FSM: temporary dialogue state"]
        REGISTER["Register managed bot"]
        CLAIM["Poll unclaimed personal bots"]
        ACCESS["Restrict access to claimant ID"]
        DB[("Local SQLite: bots, limits, tokens")]
    end

    OWNER -->|Select user button| TG_BOT
    TG_BOT --> TG_EVENTS
    TG_EVENTS --> WEBHOOK --> VALIDATE --> PUBLISH --> QUEUE --> CELERY --> ROUTER

    ROUTER --> DIALOG
    DIALOG <--> FSM
    DIALOG <--> DB
    DIALOG -->|request_users / request_managed_bot| TG_UI
    OWNER -->|select recipient; confirm creation| TG_UI
    TG_UI -->|users_shared / managed_bot| TG_EVENTS

    ROUTER -->|managed_bot| REGISTER
    REGISTER -->|getManagedBotToken| TG_API
    REGISTER --> DB
    REGISTER --> CLAIM
    CLAIM -->|one-time link to personal bot| CHILD
    RECIPIENT -->|/start claim_token| CHILD
    CHILD -->|getUpdates| CLAIM
    CLAIM --> ACCESS
    ACCESS -->|set and get access settings| TG_API
    ACCESS --> DB
    TG_API --> CHILD

    ACCESS -->|ready message| CHILD
