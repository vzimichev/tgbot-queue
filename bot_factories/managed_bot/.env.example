# SQS_REGION=eu-central-1
# SQS_QUEUE_NAME=telegram_updates
# SQS_QUEUE_URL=https://sqs.eu-central-1.amazonaws.com/123456789012/telegram_updates
# SQS_POLLING_INTERVAL=1
# SQS_VISIBILITY_TIMEOUT=3600
TELEGRAM_REQUEST_TIMEOUT=600
ADMIN_BOT_TOKEN=123456:replace-me
ADMIN_BOT_OWNER_ID=123456789
# Must match WEBHOOK_SECRET_TOKEN in the gateway .env.
WEBHOOK_SECRET_TOKEN=replace-with-the-gateway-secret
ADMIN_BOT_CHILD_WEBHOOK_URL=https://your-domain.example/webhook/managed
