[Unit]
Description=Telegram admin bot polling worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tgbot-gateway
Group=tgbot-gateway
WorkingDirectory=@PROJECT_DIR@
EnvironmentFile=@PROJECT_DIR@/.env
Environment=ADMIN_BOT_DATA_DIR=/var/lib/tgbot-admin
ExecStart=@VENV_DIR@/bin/python -m bot_factories.admin_bot.polling
Restart=on-failure
RestartSec=5
StateDirectory=tgbot-admin
StateDirectoryMode=0700
UMask=0077
MemoryAccounting=true
MemoryMax=160M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
